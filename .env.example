APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# WAJIB ikut PORT tempat aplikasi benar-benar dijalankan.
# `php artisan serve` memakai 127.0.0.1:8000, sedangkan `http://localhost`
# tanpa port berarti port 80. Kalau salah, Storage::url() membangun alamat
# gambar QRIS ke port yang kosong dan gambarnya gagal dimuat TANPA pesan
# error apa pun — yang terlihat cuma preview QRIS yang hilang.
APP_URL=http://127.0.0.1:8000

# Alamat yang di-encode ke QR menu meja. Harus lengkap sampai /scan.
# Kalau dikosongkan, config/soyascan.php jatuh ke APP_URL mentah dan hasil
# scan-nya mendarat di "/" yang belum punya route (404).
#
# Untuk uji dengan HP betulan: ganti ke IP komputer di wifi yang sama, mis.
# http://192.168.1.7:8000/scan — lalu jalankan `php artisan serve --host=0.0.0.0`.
# Alamat 127.0.0.1 berarti "perangkat ini sendiri", jadi HP tidak akan menemukannya.
SOYASCAN_URL=http://127.0.0.1:8000/scan

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Cost 12 memakan ~300 ms tiap login. Untuk lokal 10 sudah cukup;
# production tetap 12.
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# JANGAN arahkan ke Supabase saat ngoding. Servernya di AWS Mumbai: sekali
# connect ~1.700 ms dan satu query ~600-1.200 ms dari Indonesia, sehingga
# halaman dashboard (yang memanggil 9 endpoint sekaligus) terasa menggantung
# puluhan detik. SQLite lokal menjawab di bawah 1 ms.
#
# Kredensial Supabase hanya dipakai di server production, bukan di sini.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session, cache, dan queue sengaja TIDAK di database. Ketiganya dibaca dan
# ditulis di hampir setiap request; menaruhnya di database berarti menambah
# beberapa round-trip per halaman tanpa manfaat apa pun saat development.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
